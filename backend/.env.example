# =============================================================================
# Django Configuration
# =============================================================================

# SECRET_KEY: generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-your-generated-secret-key

# DEBUG: True only for local development. NEVER True in production.
DEBUG=True

# ALLOWED_HOSTS: comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1


# =============================================================================
# Database
# =============================================================================
#
# Local (demo): lasă TOTUL comentat mai jos → aplicația folosește SQLite (zero config).
#
# Producție (Render / Neon): NU folosi variabilele DB_* de mai jos. În loc,
# setează un singur DATABASE_URL (îl injectează Render automat din render.yaml,
# sau îl copiezi din Neon). Exemplu de format:
#   DATABASE_URL=postgres://user:parola@host:5432/numebaza
# DATABASE_URL=

# Alternativ, MySQL local (necesită decomentarea mysqlclient în requirements.txt):
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=agri_db
# DB_USER=your_mysql_user
# DB_PASSWORD=your_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3306


# =============================================================================
# Oblio API (Romanian invoicing service — https://www.oblio.eu/)
# =============================================================================

# Leave empty if you don't want to integrate with Oblio.
# Get credentials from your Oblio account -> API section.
OBLIO_CLIENT_ID=your-oblio-email@example.com
OBLIO_CLIENT_SECRET=your-oblio-api-secret
OBLIO_COMPANY_CIF=your-company-CIF
OBLIO_SERIES_NAME=your-invoice-series-name


# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# Explicit list of allowed origins for the frontend.
# NEVER use CORS_ALLOW_ALL_ORIGINS=True in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
