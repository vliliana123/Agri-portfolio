# =============================================================================
# Frontend Environment Variables (React / Create React App)
# =============================================================================

# API endpoint override (optional).
# By default the frontend uses `http://<current-hostname>:8000/api`
# from services/api.ts. Set only if your backend runs elsewhere.
# REACT_APP_API_URL=http://localhost:8000/api

# WARNING: never enable this in production. Disables webpack host check.
# DANGEROUSLY_DISABLE_HOST_CHECK=false
